# Cabeceras de seguridad para Cloudflare Pages (GitHub Pages ignora este archivo).
# HSTS: siempre por HTTPS. X-Frame-Options y frame-ancestors: nadie puede meter la web dentro de otra página.
# nosniff: el navegador no adivina tipos de archivo. Referrer-Policy: al salir a otro sitio solo se informa el dominio.
# Permissions-Policy: la web no usa cámara, micrófono, ubicación ni pagos, así que quedan bloqueados.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

# El panel no aparece en buscadores ni queda guardado en el navegador.
/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# Fotos y videos: el navegador los guarda una semana.
/img/*
  Cache-Control: public, max-age=604800
